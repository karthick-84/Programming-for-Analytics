# a salary from the user and determine how much tax someone should pay according

salary = float(input("Enter your salary: "))

if salary <= 10000:
    tax = 0
elif salary <= 50000:
    tax = (salary - 10000) * 0.20
else:
    tax = (40000 * 0.20) + ((salary - 50000) * 0.40)

print("Tax to be paid: €", tax)

