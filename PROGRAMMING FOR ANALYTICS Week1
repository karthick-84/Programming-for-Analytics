# 7. Conversion Functions
# -----------------------------------------

# Kilometers ↔ Miles
def km_to_miles(km):
    return km * 0.621371

def miles_to_km(miles):
    return miles / 0.621371

# Centigrade ↔ Fahrenheit
def c_to_f(c):
    return (c * 9/5) + 32

def f_to_c(f):
    return (f - 32) * 5/9


